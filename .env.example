# =========================================================
# DOCKER COMPOSE
# =========================================================

COMPOSE_PROJECT_NAME=scms


# =========================================================
# FRONTEND
# =========================================================

# Host port: localhost:5174
# Container port: 5173

FRONTEND_HOST_PORT=5174


# =========================================================
# BACKEND
# =========================================================

# Host port: localhost:8081
# Container port: 8080

BACKEND_HOST_PORT=8081


# =========================================================
# POSTGRESQL
# =========================================================

POSTGRES_DB=scms

POSTGRES_USER=udom-scms
POSTGRES_PASSWORD=udom-scms

# Host: localhost:5433
# Docker internal: postgres:5432

POSTGRES_HOST_PORT=5433


# =========================================================
# PGADMIN
# =========================================================

# pgAdmin requires a valid email address as the username
PGADMIN_DEFAULT_EMAIL=udom-scms@udom.ac.tz
PGADMIN_DEFAULT_PASSWORD=udom-scms

# Host: localhost:5051
# Docker internal: 80

PGADMIN_HOST_PORT=5051


# =========================================================
# REDIS
# =========================================================

# Redis authentication is not currently configured.
# Host: localhost:6380
# Docker internal: redis:6379

REDIS_HOST_PORT=6380


# =========================================================
# MINIO
# =========================================================

MINIO_ROOT_USER=udom-scms
MINIO_ROOT_PASSWORD=udom-scms

# Host API: localhost:9002
# Docker internal API: 9000

MINIO_API_HOST_PORT=9002

# Host Console: localhost:9003
# Docker internal Console: 9001

MINIO_CONSOLE_HOST_PORT=9003


# =========================================================
# RABBITMQ
# =========================================================

RABBITMQ_DEFAULT_USER=udom-scms
RABBITMQ_DEFAULT_PASS=udom-scms

RABBITMQ_VHOST=/scms

# Host: localhost:5673
# Docker internal: rabbitmq:5672

RABBITMQ_HOST_PORT=5673

# Host Management UI: localhost:15673
# Docker internal Management UI: 15672

RABBITMQ_MANAGEMENT_HOST_PORT=15673


# =========================================================
# FRONTEND -> BACKEND
# =========================================================

# Browser accesses backend through the host port

VITE_API_BASE_URL=http://localhost:8081


# =========================================================
# CORS
# =========================================================

CORS_ALLOWED_ORIGINS=http://localhost:5174